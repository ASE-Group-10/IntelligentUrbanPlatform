# Copy the root .env.example defaults or provide a PostgreSQL connection URL.
DATABASE_URL=postgresql+psycopg://ulop:ulop@localhost:5432/ulop
MOCK_DEPENDENCIES=true
AVAILABILITY_MAX_AGE_SECONDS=86400

# Project origin for asymmetric Supabase Auth signing keys
SUPABASE_URL=https://your-project.supabase.co

# Optional C08 telemetry via the local Datadog Agent's OTLP HTTP receiver.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
