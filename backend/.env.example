# Copy the root .env.example defaults or provide a PostgreSQL connection URL.
DATABASE_URL=postgresql+psycopg://ulop:ulop@localhost:5432/ulop
# Separate least-privilege replay login; unset disables replay endpoints.
# REPLAY_DATABASE_URL=postgresql+psycopg://<replay-login>:<secret>@localhost:5432/ulop
MOCK_DEPENDENCIES=true
AVAILABILITY_MAX_AGE_SECONDS=86400

# Project origin for asymmetric Supabase Auth signing keys
SUPABASE_URL=https://your-project.supabase.co

# Comma-separated hostnames accepted in the HTTP Host header (no scheme or port).
# Include your public API DNS name alongside localhost/127.0.0.1 on shared VMs.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Optional comma-separated frontend origins allowed for browser CORS requests
# (leave empty when using the local Vite /api proxy or same-origin hosting).
CORS_ORIGINS=
