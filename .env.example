# Copy to .env and adjust. Never commit .env.

POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ulop:ulop@localhost:5432/ulop

# Optional shared migration target. For Supabase, use the session pooler on
# port 5432; the direct connection is IPv6-only and the transaction pooler
# (6543) is unsuitable for migrations.
# MIGRATION_DATABASE_URL=postgres://<user>:<password>@<host>:5432/postgres?sslmode=require

RABBITMQ_USER=ulop
RABBITMQ_PASSWORD=ulop
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://ulop:ulop@localhost:5672/%2F
RABBITMQ_EXCHANGE=ulop.events
