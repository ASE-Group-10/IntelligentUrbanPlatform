# Copy to .env and adjust. Never commit .env.
# These defaults are for the local Docker Compose database only.

# Host port for the local Postgres container (change if 5432 is taken).
POSTGRES_PORT=5432

# Connection string for code and tools running on your machine.
DATABASE_URL=postgres://ulop:ulop@localhost:5432/ulop?sslmode=disable

# Optional: point the dbmate container at another database (e.g. Supabase)
# instead of the local one. For Supabase use the session-pooler connection
# (port 5432): the direct connection is IPv6-only and usually fails from
# Docker, and the transaction pooler (6543) breaks migrations.
# MIGRATION_DATABASE_URL=postgres://<user>:<password>@<host>:5432/postgres?sslmode=require

# Local RabbitMQ defaults for Docker Compose. Do not reuse these credentials
# outside local development.
RABBITMQ_USER=ulop
RABBITMQ_PASSWORD=ulop
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application connection URL when running on the host machine.
RABBITMQ_URL=amqp://ulop:ulop@localhost:5672/%2F
# Topic exchange for all events; each event is routed by its eventType
# (e.g. CityStateUpdated).
RABBITMQ_EXCHANGE=ulop.events
