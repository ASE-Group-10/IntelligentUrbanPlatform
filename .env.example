# Copy to .env and adjust. Never commit .env.
# These defaults are for the local Docker Compose database only.

# Host port for the local Postgres container (change if 5432 is taken).
POSTGRES_PORT=5432

# Connection string for code and tools running on your machine.
DATABASE_URL=postgres://ulop:ulop@localhost:5432/ulop?sslmode=disable

# Optional: point the dbmate container at another database (e.g. Supabase)
# instead of the local one. Use the direct or session-pooler connection
# (port 5432), not the transaction pooler (6543).
# MIGRATION_DATABASE_URL=postgres://<user>:<password>@<host>:5432/postgres?sslmode=require
