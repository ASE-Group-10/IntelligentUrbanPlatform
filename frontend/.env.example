# Copy to .env.local (ignored by Git). Only VITE_* variables reach the browser,
# so never put secrets here.

# Base URL the browser uses for the backend. "/api" goes through the Vite dev
# proxy to API_PROXY_TARGET (default http://127.0.0.1:8000).
VITE_API_BASE_URL=/api

# Map style: OpenFreeMap needs no API key. Keep the OpenStreetMap attribution.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
